generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum TimeOfDay {
  DAY
  NIGHT
  DAWN
  DUSK
}

enum IntExt {
  INT
  EXT
  INT_EXT
}

enum ShotStatus {
  PLANNED
  SHOT
  CUT
}

enum EquipmentSource {
  OWNED
  RENTED
  BORROWED
}

enum CastingStatus {
  CONSIDERING
  OFFERED
  CONFIRMED
  DECLINED
}

enum AssetType {
  IMAGE
  VIDEO
  DIAGRAM
}

enum AssetSource {
  UPLOADED
  GENERATED
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum GenerationMode {
  IMAGE
}

/**
 * QUICK   — the filmmaker typed a free-text prompt directly.
 * STRUCTURED — the prompt was compiled from the shot by the prompt compiler.
 */
enum GenerationSource {
  QUICK
  STRUCTURED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  logline     String?
  description String?
  genre       String?
  format      String?
  status      String   @default("Development")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members          ProjectMember[]
  scenes           Scene[]
  scheduleDays     ScheduleDay[]
  castMembers      CastMember[]
  crewMembers      CrewMember[]
  locations        Location[]
  equipmentItems   Equipment[]
  budgetCategories BudgetCategory[]
  assets           Asset[]
  generations      Generation[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Scene {
  id            String    @id @default(cuid())
  projectId     String
  number        String
  intExt        IntExt    @default(INT)
  location      String
  timeOfDay     TimeOfDay @default(DAY)
  synopsis      String?
  scriptText    String?
  action        String?
  emotionalBeat String?
  directorNotes String?
  pageEights    Float     @default(1)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots         ShotListItem[]
  scheduleItems ScheduleItem[]
  assets        Asset[]
  characters    CastMember[]
  generations   Generation[]

  @@index([projectId])
}

model ShotListItem {
  id          String     @id @default(cuid())
  sceneId     String
  shotNumber  String
  shotType    String
  description String?
  status      ShotStatus @default(PLANNED)

  // Camera
  cameraAngle         String?
  cameraHeight        String?
  lens                String?
  focalLength         String?
  cameraMovement      String?
  cameraStartPosition String?
  cameraEndPosition   String?
  movementSpeed       String?

  // Temporal framing state. Distinct from shotType (the shot's designation) and
  // from cameraStart/EndPosition (where the camera physically sits): these are
  // what the frame actually shows at the head and tail of a moving shot.
  initialFraming String?
  finalFraming   String?

  // Subject / blocking
  subjectMovement      String?
  subjectStartPosition String?
  subjectEndPosition   String?
  characterBlocking    String?

  // Movement in the environment itself (fog drifting, rain, crowd) — distinct
  // from camera and subject movement.
  environmentalMovement String?

  // Composition. `composition` is spatial placement (subject on the left third)
  // and `framing` is shot scale (tight/loose) — two different things. Both are
  // treated as stable for the duration of the shot unless a temporal transition
  // is explicitly specified via finalComposition / finalFraming.
  composition      String?
  finalComposition String?
  framing          String?
  depthOfField     String?

  // Lighting & mood
  lightingNotes String?
  mood          String?

  // Audio & timing
  durationSeconds  Float?
  dialogueAudio    String?
  sfx              String?
  soundDesignNotes String?

  // Edit
  transition String?
  editPoint  String?

  // Notes
  equipmentNotes String?
  directorNotes  String?

  // Spatial blocking for the composition canvas: camera placement and field of
  // view, subject start/end positions and orientation, props, and frame
  // composition. Stored here rather than in a parallel visualization table so
  // the Shot stays the single source of truth. Shape is validated by
  // blockingSchema (src/lib/blocking.ts) on every write.
  blocking Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene       Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  assets      Asset[]
  generations Generation[]

  @@index([sceneId])
}

/**
 * One generation attempt. A regeneration creates another row rather than
 * overwriting this one, so a shot accumulates its generation history.
 * `promptUsed` is the exact text sent to the provider — including any hand
 * edits — so the record always reflects what actually produced the image, while
 * the Shot stays the source of truth for compiling future generations.
 */
model Generation {
  id        String           @id @default(cuid())
  projectId String
  sceneId   String?
  shotId    String?
  mode      GenerationMode   @default(IMAGE)
  source    GenerationSource
  status    GenerationStatus @default(QUEUED)

  /**
   * Exactly what was sent to the provider.
   */
  promptUsed   String
  /**
   * True when the filmmaker edited the compiled prompt before generating.
   */
  promptEdited Boolean @default(false)
  /**
   * The CinematicPromptSpec at generation time; null for free-text generations.
   */
  specSnapshot Json?

  /**
   * Which image provider ran it, and which prompt adapter formatted the text.
   */
  providerId       String
  promptProviderId String?

  error String?

  assetId String? @unique
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot    ShotListItem? @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([shotId])
}

model Asset {
  id        String      @id @default(cuid())
  projectId String
  sceneId   String?
  shotId    String?
  type      AssetType
  source    AssetSource
  filePath  String
  mimeType  String
  fileSize  Int
  caption   String?
  prompt    String?
  createdAt DateTime    @default(now())

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene      Scene?        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot       ShotListItem? @relation(fields: [shotId], references: [id], onDelete: Cascade)
  generation Generation?

  @@index([projectId])
  @@index([sceneId])
  @@index([shotId])
}

model ScheduleDay {
  id        String   @id @default(cuid())
  projectId String
  dayNumber Int
  date      DateTime
  callTime  String?
  wrapTime  String?
  location  String?
  weather   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ScheduleItem[]

  @@index([projectId])
}

model ScheduleItem {
  id            String  @id @default(cuid())
  scheduleDayId String
  sceneId       String?
  startTime     String?
  endTime       String?
  notes         String?
  order         Int     @default(0)

  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  scene       Scene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([scheduleDayId])
}

model CastMember {
  id            String        @id @default(cuid())
  projectId     String
  actorName     String?
  characterName String
  contactEmail  String?
  contactPhone  String?
  status        CastingStatus @default(CONSIDERING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]

  @@index([projectId])
}

model CrewMember {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  department   String
  position     String
  contactEmail String?
  contactPhone String?
  dayRate      Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Location {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  permitStatus String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Equipment {
  id        String          @id @default(cuid())
  projectId String
  name      String
  category  String
  quantity  Int             @default(1)
  source    EquipmentSource @default(OWNED)
  dailyCost Float?
  vendor    String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BudgetCategory {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BudgetLineItem[]

  @@index([projectId])
}

model BudgetLineItem {
  id          String   @id @default(cuid())
  categoryId  String
  description String
  estimated   Float    @default(0)
  actual      Float    @default(0)
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}
