generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum TimeOfDay {
  DAY
  NIGHT
  DAWN
  DUSK
}

enum IntExt {
  INT
  EXT
  INT_EXT
}

enum ShotStatus {
  PLANNED
  SHOT
  CUT
}

enum EquipmentSource {
  OWNED
  RENTED
  BORROWED
}

enum CastingStatus {
  CONSIDERING
  OFFERED
  CONFIRMED
  DECLINED
}

enum AssetType {
  IMAGE
  VIDEO
  DIAGRAM
}

enum AssetSource {
  UPLOADED
  GENERATED
}

/**
 * Where an asset's bytes actually live.
 * Recorded per asset rather than read from configuration, so local and
 * object-stored media coexist while a migration runs and every object is read
 * back through the provider that wrote it.
 */
enum StorageProvider {
  LOCAL
  S3
}

/**
 * Edit points the filmmaker can state on a timeline boundary.
 * There is deliberately no "unspecified" member: the field is nullable, and null
 * means the filmmaker has not chosen an edit. A plain boundary is rendered for
 * null — never a dissolve or a match cut inferred from what the adjacent shots
 * happen to be. CUT is a real choice and is displayed as one.
 */
/**
 * What the filmmaker decided about a continuity finding.
 * There is deliberately no "resolved" state: a finding is derived from the
 * shots every time the panel loads, so a difference the filmmaker actually
 * fixed stops being reported on its own. These record a judgement about a
 * difference that is still there.
 */
/**
 * Where a saved prompt's text came from.
 * COMPILED is the compiler's output taken as-is; EDITED is the filmmaker's
 * wording. The distinction is kept forever: a later compilation never rewrites
 * an edited version, it becomes a new one alongside it.
 */
enum PromptSource {
  COMPILED
  EDITED
}

enum ContinuityStatus {
  REVIEWED
  INTENTIONAL
  DISMISSED
}

enum TransitionType {
  CUT
  DISSOLVE
  FADE
  MATCH_CUT
  J_CUT
  L_CUT
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum GenerationMode {
  IMAGE
  VIDEO
  IMAGE_TO_VIDEO
}

/**
 * QUICK   — the filmmaker typed a free-text prompt directly.
 * STRUCTURED — the prompt was compiled from the shot by the prompt compiler.
 */
enum GenerationSource {
  QUICK
  STRUCTURED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  logline     String?
  description String?
  genre       String?
  format      String?
  status      String   @default("Development")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members             ProjectMember[]
  scenes              Scene[]
  scheduleDays        ScheduleDay[]
  castMembers         CastMember[]
  crewMembers         CrewMember[]
  locations           Location[]
  equipmentItems      Equipment[]
  budgetCategories    BudgetCategory[]
  assets              Asset[]
  generations         Generation[]
  sequences           Sequence[]
  continuityDecisions ContinuityDecision[]
}

/**
 * The filmmaker's judgement about one continuity difference.
 * Continuity findings themselves are NOT stored. They are recomputed from the
 * Shots, Scenes and blocking every time the panel is opened, so they can never
 * go stale and analysing never writes to filmmaking data. Only the decision is
 * persisted, attached by a deterministic `findingKey` that the analyser
 * reproduces for the same difference between the same two shots.
 * A decision therefore annotates a difference; it never removes it. Clear the
 * decision and the finding is simply open again.
 */
model ContinuityDecision {
  id         String           @id @default(cuid())
  projectId  String
  /**
   * Stable identity of the difference: category, the two shots, and the subject.
   */
  findingKey String
  status     ContinuityStatus
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, findingKey])
  @@index([projectId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Scene {
  id            String    @id @default(cuid())
  projectId     String
  number        String
  intExt        IntExt    @default(INT)
  location      String
  timeOfDay     TimeOfDay @default(DAY)
  synopsis      String?
  scriptText    String?
  action        String?
  emotionalBeat String?
  directorNotes String?
  pageEights    Float     @default(1)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots         ShotListItem[]
  scheduleItems ScheduleItem[]
  assets        Asset[]
  characters    CastMember[]
  generations   Generation[]

  @@index([projectId])
}

model ShotListItem {
  id          String     @id @default(cuid())
  sceneId     String
  shotNumber  String
  shotType    String
  description String?
  status      ShotStatus @default(PLANNED)

  // Camera
  cameraAngle         String?
  cameraHeight        String?
  lens                String?
  focalLength         String?
  cameraMovement      String?
  cameraStartPosition String?
  cameraEndPosition   String?
  movementSpeed       String?

  // Temporal framing state. Distinct from shotType (the shot's designation) and
  // from cameraStart/EndPosition (where the camera physically sits): these are
  // what the frame actually shows at the head and tail of a moving shot.
  initialFraming String?
  finalFraming   String?

  // Subject / blocking
  subjectMovement      String?
  subjectStartPosition String?
  subjectEndPosition   String?
  characterBlocking    String?

  // Movement in the environment itself (fog drifting, rain, crowd) — distinct
  // from camera and subject movement.
  environmentalMovement String?

  // Continuity properties. Each is unspecified by default, and unspecified
  // never means "absent" — continuity analysis compares stated values only.
  wardrobe       String?
  hairMakeup     String?
  // Props the character carries or handles, as distinct from set dressing
  // placed on the blocking stage.
  characterProps String?

  // Composition. `composition` is spatial placement (subject on the left third)
  // and `framing` is shot scale (tight/loose) — two different things. Both are
  // treated as stable for the duration of the shot unless a temporal transition
  // is explicitly specified via finalComposition / finalFraming.
  composition      String?
  finalComposition String?
  framing          String?
  depthOfField     String?

  // Lighting & mood
  lightingNotes String?
  mood          String?

  // Audio & timing
  durationSeconds  Float?
  dialogueAudio    String?
  sfx              String?
  soundDesignNotes String?

  // Edit
  transition String?
  editPoint  String?

  // Notes
  equipmentNotes String?
  directorNotes  String?

  // Spatial blocking for the composition canvas: camera placement and field of
  // view, subject start/end positions and orientation, props, and frame
  // composition. Stored here rather than in a parallel visualization table so
  // the Shot stays the single source of truth. Shape is validated by
  // blockingSchema (src/lib/blocking.ts) on every write.
  blocking Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene          Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  assets         Asset[]
  generations    Generation[]
  timelineClips  TimelineClip[]
  promptVersions PromptVersion[]

  @@index([sceneId])
}

/**
 * An edit — a named, ordered arrangement of the project's shots.
 * A sequence owns *placements*, not shots. Nothing about a shot is copied in
 * here: a TimelineClip points at its ShotListItem and reads the filmmaking data
 * from it, so there is exactly one representation of a shot in the system and
 * the timeline can never drift from the Shot Builder.
 * Future edit metadata (markers, beat markers, audio/dialogue/SFX/music tracks)
 * attaches as new tables related to Sequence or TimelineClip. Because both are
 * real entities rather than a blob, that is additive — no rewrite.
 */
model Sequence {
  id        String   @id @default(cuid())
  projectId String
  name      String   @default("Main edit")
  order     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips   TimelineClip[]

  @@index([projectId])
}

/**
 * One placement of a shot in a sequence.
 * Everything here is an *edit* decision, kept strictly apart from the shot's own
 * filmmaking decisions:
 * Shot.durationSeconds        what the shot is meant to be — never written here
 * inPoint / outPoint          how much of it this edit actually uses
 * Trimming a clip to 3.5s leaves a 6-second shot a 6-second shot. Deleting a
 * clip removes the placement and leaves the ShotListItem untouched, so the shot
 * can be reinserted later.
 */
model TimelineClip {
  id         String @id @default(cuid())
  sequenceId String
  shotId     String
  order      Int    @default(0)

  /**
   * Trim, in seconds from the head of the source. `outPointSeconds` null means
   * "run to the end of the source" rather than a stored copy of its length.
   */
  inPointSeconds  Float  @default(0)
  outPointSeconds Float?

  /**
   * The edit at this clip's head. Null is "not specified" and renders as a plain
   * boundary; it is not the same as an explicit CUT.
   */
  transition                TransitionType?
  transitionDurationSeconds Float?

  /**
   * Which generated/uploaded asset represents this shot in this edit.
   */
  selectedAssetId String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequence      Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  shot          ShotListItem @relation(fields: [shotId], references: [id], onDelete: Cascade)
  selectedAsset Asset?       @relation("ClipSelectedAsset", fields: [selectedAssetId], references: [id], onDelete: SetNull)

  @@index([sequenceId])
  @@index([shotId])
}

/**
 * One generation attempt. A regeneration creates another row rather than
 * overwriting this one, so a shot accumulates its generation history.
 * `promptUsed` is the exact text sent to the provider — including any hand
 * edits — so the record always reflects what actually produced the image, while
 * the Shot stays the source of truth for compiling future generations.
 */
model Generation {
  id        String           @id @default(cuid())
  projectId String
  sceneId   String?
  shotId    String?
  mode      GenerationMode   @default(IMAGE)
  source    GenerationSource
  status    GenerationStatus @default(QUEUED)

  /**
   * Exactly what was sent to the provider.
   */
  promptUsed   String
  /**
   * True when the filmmaker edited the compiled prompt before generating.
   */
  promptEdited Boolean @default(false)
  /**
   * The CinematicPromptSpec at generation time; null for free-text generations.
   */
  specSnapshot Json?

  /**
   * Which image provider ran it, and which prompt adapter formatted the text.
   */
  providerId       String
  promptProviderId String?

  /**
   * The provider's own job handle for an asynchronous generation (video).
   * Null for providers that return their result inline (image).
   */
  providerJobId String?

  /**
   * Requested clip length, for the modes that have one.
   */
  durationSeconds Float?

  error String?

  assetId String? @unique
  asset   Asset?  @relation("GenerationOutput", fields: [assetId], references: [id], onDelete: SetNull)

  /**
   * The still this clip was animated from, for IMAGE_TO_VIDEO. Kept as a
   * relation rather than a copied file so the lineage still/clip stays visible.
   */
  sourceAssetId String?
  sourceAsset   Asset?  @relation("GenerationSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot    ShotListItem? @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([shotId])
}

/**
 * A saved prompt for one shot in one mode.
 * Versions are the filmmaker's drafts; Generations are the actual uses. They are
 * kept apart on purpose: a Generation already stores the exact text that was
 * sent to a provider, so the record of what produced an asset can never be
 * altered by later editing here. A version is never overwritten — saving again
 * appends, so the history reads forwards.
 * This holds no new filmmaking data. The Shot remains the source of truth, the
 * spec is recompiled from it, and a version is a snapshot of one rendering.
 */
model PromptVersion {
  id      String         @id @default(cuid())
  shotId  String
  mode    GenerationMode
  /**
   * Sequence within (shot, mode), starting at 1.
   */
  version Int
  source  PromptSource

  /**
   * Exactly the text this version holds.
   */
  text             String
  /**
   * The CinematicPromptSpec at the moment it was saved, for the inspector.
   */
  specSnapshot     Json?
  /**
   * Which prompt adapter rendered it.
   */
  promptProviderId String?
  /**
   * For IMAGE_TO_VIDEO: the still this version was written against.
   */
  sourceAssetId    String?
  label            String?

  createdAt DateTime @default(now())

  shot ShotListItem @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@unique([shotId, mode, version])
  @@index([shotId])
}

model Asset {
  id        String      @id @default(cuid())
  projectId String
  sceneId   String?
  shotId    String?
  type      AssetType
  source    AssetSource

  /**
   * Which store holds the bytes, and the opaque key inside it.
   */
  storageProvider StorageProvider @default(LOCAL)
  storageKey      String
  /**
   * SHA-256 written at upload, so a migration can verify rather than assume.
   */
  checksum        String?

  mimeType String
  fileSize Int
  caption  String?
  prompt   String?

  /**
   * Media facts measured by the browser on first playback and reported back, so
   * the timeline can show a clip's real length and resolution. Null until a
   * player has actually decoded the file — never guessed from the container.
   */
  durationSeconds Float?
  width           Int?
  height          Int?

  createdAt DateTime @default(now())

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene           Scene?         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot            ShotListItem?  @relation(fields: [shotId], references: [id], onDelete: Cascade)
  generation      Generation?    @relation("GenerationOutput")
  /**
   * Generations that animated this asset as their source frame.
   */
  animatedBy      Generation[]   @relation("GenerationSource")
  /**
   * Timeline placements that use this asset to represent their shot.
   */
  selectedInClips TimelineClip[] @relation("ClipSelectedAsset")

  @@index([projectId])
  @@index([sceneId])
  @@index([shotId])
}

model ScheduleDay {
  id        String   @id @default(cuid())
  projectId String
  dayNumber Int
  date      DateTime
  callTime  String?
  wrapTime  String?
  location  String?
  weather   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ScheduleItem[]

  @@index([projectId])
}

model ScheduleItem {
  id            String  @id @default(cuid())
  scheduleDayId String
  sceneId       String?
  startTime     String?
  endTime       String?
  notes         String?
  order         Int     @default(0)

  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  scene       Scene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([scheduleDayId])
}

model CastMember {
  id            String        @id @default(cuid())
  projectId     String
  actorName     String?
  characterName String
  contactEmail  String?
  contactPhone  String?
  status        CastingStatus @default(CONSIDERING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]

  @@index([projectId])
}

model CrewMember {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  department   String
  position     String
  contactEmail String?
  contactPhone String?
  dayRate      Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Location {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  permitStatus String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Equipment {
  id        String          @id @default(cuid())
  projectId String
  name      String
  category  String
  quantity  Int             @default(1)
  source    EquipmentSource @default(OWNED)
  dailyCost Float?
  vendor    String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BudgetCategory {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BudgetLineItem[]

  @@index([projectId])
}

model BudgetLineItem {
  id          String   @id @default(cuid())
  categoryId  String
  description String
  estimated   Float    @default(0)
  actual      Float    @default(0)
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}
