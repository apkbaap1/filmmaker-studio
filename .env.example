# PostgreSQL connection string.
# Matches `docker compose up -d` out of the box — change if using your own DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filmmaker_studio?schema=public"

# NextAuth - generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: where uploaded/generated visualization assets are stored on disk.
# Defaults to ./storage/uploads if unset.
# STORAGE_DIR="./storage/uploads"

# Optional: enables the "Generate with AI" storyboard feature (gpt-image-1).
# Without this, upload/organize still works fully — generation just shows
# a setup message. Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
