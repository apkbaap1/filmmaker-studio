# PostgreSQL connection string.
# Matches `docker compose up -d` out of the box — change if using your own DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filmmaker_studio?schema=public"

# NextAuth - generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# --- Media storage -----------------------------------------------------------
# With no S3_* variables set, media is written to local disk. That is a
# DEVELOPMENT backend: it does not survive a serverless deploy or a replaced
# container, and cannot be shared between app instances. See README > Storage.
#
# Optional: where local-disk media lives. Defaults to ./storage/uploads.
# STORAGE_DIR="./storage/uploads"

# Optional: signs the short-lived /api/media URLs used by the local backend.
# Falls back to AUTH_SECRET when unset. Never sent to the browser.
# MEDIA_URL_SECRET="replace-with-a-long-random-string"

# Production: any S3-compatible object store (AWS S3, Cloudflare R2, Backblaze
# B2, MinIO, Wasabi). Set these and new media goes to the bucket instead, with
# no code change. The bucket should be PRIVATE — the application never depends
# on public object URLs, and access is decided in the app, not by the URL.
#
# These are server-side credentials. They are read only inside
# src/lib/storage/s3.ts and are never bundled into the browser.
# S3_BUCKET="filmmaker-studio"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_FORCE_PATH_STYLE="true"                                  # MinIO et al.
#
# Already have assets on local disk? After configuring the above:
#   npm run storage:migrate              # report only
#   npm run storage:migrate -- --apply   # upload, verify, repoint (never deletes)

# --- Deployment --------------------------------------------------------------
# A production build refuses an untrusted Host header. Set the app's public URL,
# or AUTH_TRUST_HOST=true when TLS is terminated in front of it.
# AUTH_URL="https://filmmaker.example.com"
# AUTH_TRUST_HOST="true"

# The real image provider: OpenAI gpt-image-1. This is the ONE external
# generation provider implemented; nothing else is claimed or configured.
#
# With no key set, image generation is simply unavailable and the UI says so —
# it never falls back to a stub and presents the result as AI generation.
# Get a key at https://platform.openai.com/api-keys
#
# THIS CREDENTIAL IS BILLED. See the generation limits below before exposing the
# application to anyone else.
# OPENAI_API_KEY="sk-..."

# Optional: point image generation at an OpenAI-compatible endpoint instead of
# OpenAI itself (Azure OpenAI, a gateway, a local stub). Defaults to
# https://api.openai.com/v1
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Cost protection ----------------------------------------------------------
# Hard ceilings, enforced server-side before any paid generation is queued.
# These are NOT billing or quota accounting (Workstream 11.7 owns that) — they
# are a blunt stop so nothing can run away in the meantime. They count attempts,
# not successes, because a failed generation was still paid for. Local stub
# generations are not counted at all.
#
# Every one has a finite default; there is deliberately no "unlimited" setting.
# GENERATION_LIMIT_PER_USER="50"        # per user, across all their projects
# GENERATION_LIMIT_PER_PROJECT="200"    # per project
# GENERATION_LIMIT_CONCURRENT="5"       # in flight at once, per project
# GENERATION_LIMIT_PER_REQUEST="1"      # images one request may ask for
# GENERATION_LIMIT_WINDOW_HOURS="24"    # the rolling window the first two use

# --- Generation providers and the worker -------------------------------------
# Generation runs in a separate worker process (`npm run worker`), not in the
# browser and not inside a request. Without a worker running, jobs queue up and
# stay queued. See README > Background generation.
#
# Optional: use the deterministic local image stub instead of OpenAI. It renders
# a flat PNG derived from the prompt — enough to exercise the pipeline end to
# end, and never a substitute for real generation. Unset means OpenAI.
# IMAGE_PROVIDER="local-stub"

# Optional: how long a worker's lease lasts and how often it looks for work.
# WORKER_ID="worker-1"            # defaults to hostname-pid-random
# WORKER_IDLE_MS="1000"           # sleep when the queue is empty
# GENERATION_POLL_INTERVAL_MS="5000"   # how soon a submitted job is polled again

# Which video provider drives previsualization clips. Leave unset to disable
# video generation entirely — there is no default, and nothing falls back.
#
#   google-veo   Google Veo 3.1 through the Gemini Developer API. REAL and
#                BILLED per render. Requires GOOGLE_API_KEY below.
#   local-stub   Returns a labelled placeholder clip so the video and
#                image-to-video pipeline can be exercised locally. Never
#                evidence of AI generation, and never billed.
#
# VIDEO_PROVIDER="google-veo"
# VIDEO_PROVIDER="local-stub"

# The real video provider's credential, read only inside
# src/lib/ai/video-providers/google-veo.ts and never bundled into the browser.
# Get a key at https://aistudio.google.com/apikey — Veo is not in the free tier,
# so the key's project needs billing enabled.
#
# THIS CREDENTIAL IS BILLED.
# GOOGLE_API_KEY="..."

# Optional: which of the three Veo 3.1 models to drive. Defaults to
# veo-3.1-generate-preview; "fast" and "lite" cost less. All three are preview
# model ids and can be withdrawn by Google.
# GOOGLE_VEO_MODEL="veo-3.1-generate-preview"

# Optional: point video generation at a different host (a mock, a proxy).
# Defaults to https://generativelanguage.googleapis.com/v1beta
# GOOGLE_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# VIDEO_STUB_DELAY_MS="1500"
# VIDEO_STUB_DIR="/tmp/filmmaker-stub-jobs"   # the stub's job store; set this when
#                                             # running more than one worker
